# libFuzzer dictionary for ipc_decoder_fuzz and rpc_error_fuzz.
#
# decode_wire_header_v1 rejects on the first four bytes unless they are exactly
# "OSIP". Random mutation finds that at a rate of 1 in 2^32, so without this
# entry the fuzzer never reaches header size, version, flag validation, payload
# bounds or the reserved-field checks at all.
#
# Keep in step with core/osipc/include/os/ipc/wire.hpp and constants.hpp.

magic_osip="OSIP"
header_size_40="\x28\x00"
transport_version_1="\x01\x00"
reserved_zero="\x00\x00"
checksum_zero="\x00\x00\x00\x00"

# WireFlag values as they appear little-endian in the u32 flags field. Valid
# headers carry exactly one primary class, so these are the discriminators the
# validator actually branches on.
flag_request="\x01\x00\x00\x00"
flag_response="\x02\x00\x00\x00"
flag_event="\x04\x00\x00\x00"
flag_response_error="\x0a\x00\x00\x00"
flag_request_oneway="\x11\x00\x00\x00"
flag_request_cancellable="\x21\x00\x00\x00"
flag_has_handles="\x40\x00\x00\x00"
# One bit above the known-flag mask: the value the unknown-flag rejection exists
# to catch.
flag_unknown_bit="\x80\x00\x00\x00"

# Payload size boundaries around max_inline_payload_size (64 KiB).
payload_size_zero="\x00\x00\x00\x00"
payload_size_max="\x00\x00\x01\x00"
payload_size_over_max="\x01\x00\x01\x00"

# Handle count boundaries around max_handle_count (16).
handle_count_max="\x10\x00"
handle_count_over_max="\x11\x00"

# ErrorDomain values for the 8-byte RPC error envelope: core..security.
error_domain_core="\x01\x00"
error_domain_ipc="\x02\x00"
error_domain_security="\x06\x00"
error_domain_out_of_range="\x07\x00"

# UTF-8 shapes the validator must reject: overlong, surrogate, and above
# U+10FFFF. Seeding these puts mutation next to the accept/reject boundary.
utf8_overlong_two="\xc0\x80"
utf8_overlong_three="\xe0\x80\x80"
utf8_surrogate="\xed\xa0\x80"
utf8_above_max="\xf4\x90\x80\x80"
utf8_lone_continuation="\x80"
